# Copy to .env and fill in. `.env` is gitignored.

# ── Database (Postgres 17) ─────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=dental
DB_PASSWORD=
DB_NAME=taraz

# ── API ────────────────────────────────────────────────────
API_PORT=3400
NODE_ENV=development
CORS_ORIGIN=http://localhost:4400
# The practice's calendar; every Jalali month boundary is taken on this clock.
CLINIC_TIMEZONE=Asia/Tehran

# ── Sign-in ────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
SESSION_DAYS=30
# true behind HTTPS (the production default)
#COOKIE_SECURE=true

# ── First sign-in (created by `npm run seed`) ──────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
