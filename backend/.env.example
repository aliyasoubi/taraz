# Copy to backend/.env for local development:  cp backend/.env.example backend/.env
ENV=development
DATABASE_URL=sqlite:///./data/dev.db
# Generate with:  .venv/bin/python -m app.cli hash-password
AUTH_PASSWORD_HASH=''
SECRET_KEY=change-me-to-a-long-random-string
# Plain http on localhost; production keeps the default (true).
COOKIE_SECURE=false
