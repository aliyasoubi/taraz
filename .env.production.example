# Copy to .env beside compose.yml on the VPS:  cp .env.production.example .env && chmod 600 .env

# Public address. Needs a DNS A record pointing at this VPS.
TARAZ_DOMAIN=taraz.dentixo.ir

# The database password. The database is reachable only from the Taraz app.
# Generate with:  openssl rand -hex 24
DB_PASSWORD=

# Signs the session cookie. Generate with:  openssl rand -hex 48
JWT_SECRET=

# How long a login lasts on the phone.
SESSION_DAYS=30
# The practice's calendar; every Jalali month boundary is taken on this clock.
CLINIC_TIMEZONE=Asia/Tehran

# patient-book's compose project, its Docker network, and the folder its Caddy imports sites from.
PB_PROJECT=patient-book
PROXY_NETWORK=patient-book_internal
CADDY_SITES=/opt/caddy/sites

# Mirrors, only if Docker Hub / the npm registry are unreachable from the VPS, e.g.
#   NODE_IMAGE=docker.arvancloud.ir/node:22-alpine
#   POSTGRES_IMAGE=docker.arvancloud.ir/postgres:17-alpine
#   NPM_REGISTRY=<an npm registry mirror the VPS can reach>
