# Copy to .env beside compose.yml on the VPS:  cp .env.production.example .env && chmod 600 .env

# Login password, stored only as an argon2 hash. Generate it (asks for the password twice):
#   docker compose run --rm --no-deps taraz python -m app.cli hash-password
# and paste the printed line here. Keep the single quotes — the hash contains `$`.
AUTH_PASSWORD_HASH=''

# Signs the session cookie. Generate with:  openssl rand -base64 48
SECRET_KEY=

# How long a login lasts on the phone.
SESSION_DAYS=30

# Docker network of the reverse proxy (patient-book's Caddy).
PROXY_NETWORK=patient-book_internal

# Mirrors, only if Docker Hub / PyPI are unreachable from the VPS, e.g.
#   PYTHON_IMAGE=docker.arvancloud.ir/python:3.12-slim
#   NODE_IMAGE=docker.arvancloud.ir/node:22-alpine
#   PIP_INDEX_URL=https://mirror-pypi.runflare.com/simple
