# Add to patient-book's ops/deploy/Caddyfile (and pass TARAZ_DOMAIN to its `web`
# service). Caddy issues the certificate for this subdomain on its own.
{$TARAZ_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# JSON only; nothing large is ever uploaded.
	request_body {
		max_size 1MB
	}

	# Taraz serves its own CSP and cache headers.
	reverse_proxy taraz:8000
}
